# Compiler files
cache/
out/

# Commonly ignored directories
.logs/
.ignore/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs
# Generated forge docs stay out; screenshots and CRE run logs are kept.
docs/*
!docs/screens/
!docs/cre/

# Dotenv file
.env
.env.*
!.env.example

# Local tooling
.vercel/
node_modules/
